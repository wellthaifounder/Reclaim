# Secrets for edge functions running against the LOCAL stack.
#
# Copy to `supabase/functions/.env` and fill in. That file is gitignored and
# must stay that way. Values here are names and shapes only — never commit a
# real key to this example.
#
# In production these are NOT read from a file: they live in Supabase Edge
# Function Secrets (`supabase secrets set`). Vercel env vars are for the
# frontend's VITE_* values only.
#
# A function whose secrets are missing does not fail loudly at boot — it starts,
# accepts the request, and fails at the moment it needs the key. Receipt
# scanning did exactly that for weeks: the container was serving, the request
# authenticated, and the only sign was "Unable to process receipt" in the
# browser with the real reason in the container log.

# ── Receipt OCR + Pub 502 classifier (Vertex AI) ─────────────────────────────
# Required by: process-receipt-ocr, classify-expense.
# Without all four, scanning a receipt returns 500 and the app falls back to
# asking the user to type the details in.
#
# Setup, out of repo and in this order:
#   1. Sign the Google Cloud BAA. Receipt images are PHI; the plain AI Studio
#      endpoint (generativelanguage.googleapis.com) is NOT BAA-eligible and
#      must never receive them. Vertex AI is.
#   2. Enable the Vertex AI API on the project.
#   3. Create a service account with roles/aiplatform.user, and download a
#      JSON key.
#   4. Fill in the four values below from that JSON.
GOOGLE_SA_CLIENT_EMAIL=   # "client_email" from the service-account JSON
GOOGLE_SA_PRIVATE_KEY=    # "private_key" from the same JSON; keep the literal \n escapes, wrap in double quotes
GCP_PROJECT=              # the GCP project id hosting Vertex AI
VERTEX_REGION=us-central1

# ── Plaid ────────────────────────────────────────────────────────────────────
# Required by: plaid-create-link-token, plaid-exchange-token,
# plaid-sync-transactions, plaid-webhook.
PLAID_ENV=sandbox         # sandbox | development | production
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENCRYPTION_KEY=     # base64-encoded 32 bytes; encrypts stored access tokens at rest

# ── Stripe ───────────────────────────────────────────────────────────────────
# Required by: create-checkout, customer-portal, check-subscription.
STRIPE_SECRET_KEY=

# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected
# automatically by the local stack and by hosted Supabase. Do not set them here.
